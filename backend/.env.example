# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin
# Local development default: http://localhost:5173
# Can be comma-separated or set to deployed Vercel domain in production
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=tripzo_super_secret_jwt_key_2024_secure_telemetry
JWT_EXPIRES_IN=7d

# Database Configuration
# If MONGO_URI is omitted or left blank, the backend automatically spins up an embedded MongoMemoryServer
MONGO_URI=mongodb://localhost:27017/tripzo

# Routing & ETA Engine
OSRM_BASE_URL=https://router.project-osrm.org
ETA_CACHE_TTL_SECONDS=30

# Telemetry Safeguards
MAX_TRIP_DURATION_HOURS=3
LOCATION_PING_TTL_DAYS=7
OFFLINE_TIMEOUT_SECONDS=180
